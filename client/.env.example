# Firebase web app config (client-side, safe to expose - these are public identifiers).
# Get these from Firebase Console > Project Settings > Your apps > Web app > SDK setup.
# Without this file, login silently breaks: Vite replaces the missing vars with `undefined`
# and Firebase throws auth/invalid-api-key on every sign-in attempt.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
